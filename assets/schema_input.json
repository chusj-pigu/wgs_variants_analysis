{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/cnvanalysis/master/assets/schema_input.json",
    "title": "nf-core/cnvanalysis pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "path_to_fastq": {
                "type": "string",
                "format": "directory-path",
                "exists": true,
                "errorMessage": "Path to FastQ directory must be provided and must exist"
            },
            "ref": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "errorMessage": "Path to reference file must be provided and must exist"
            },
            "karyotype_ref": {
                "errorMessage": "Path to NASVAR reference file (.json) must be provided and must exist when --karyotype is TRUE",
                "anyOf": [
                    {
                        "type": "string",
                        "format": "file-path",
                        "exists": true,
                        "pattern": "^\\S+\\.(json)$"
                    },
                    { "type": "string", "maxLength": 0 }
                ]
            },
            "karyotype_repeats": {
                "errorMessage": "Path to NASVAR repeats reference file (.bed) must be provided and must exist when --karyotype is TRUE",
                "anyOf": [
                    {
                        "type": "string",
                        "format": "file-path",
                        "exists": true,
                        "pattern": "^\\S+\\.(bed)$"
                    },
                    { "type": "string", "maxLength": 0 }
                ]                
            },
            "karyotype_config": {
                "errorMessage": "Path to NASVAR config file (.json) must be provided and must exist when --karyotype is TRUE",
                "anyOf": [
                    {
                        "type": "string",
                        "format": "file-path",
                        "exists": true,
                        "pattern": "^\\S+\\.(json)$"
                    },
                    { "type": "string", "maxLength": 0 }
                ]     
            },
            "karyotype_cov_cutoff": {
                "errorMessage": "Coverage cut-off must be provided when --karyotype is TRUE [default: 0.2]",
                "anyOf": [
                    {
                        "type": "number",
                        "minimum": 0.01,
                        "default": 0.2
                    },
                    { "type": "string", "maxLength": 0 }
                ]
            }

        },
        "required": ["sample", "path_to_fastq", "ref"]
    }
}
